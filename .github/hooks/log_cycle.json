{
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "command": "cmd /d /c \"python \"\"%USERPROFILE%/.github/agents/Orchestrator/scripts/log_hook_runner.py\"\" --phase pre --summary \"\"Pre-tool invocation\"\"\"",
        "cwd": ".",
        "timeout": 5
      }
    ]
    ,"PostToolUse": [
      {
        "type": "command",
        "command": "cmd /d /c \"python \"\"%USERPROFILE%/.github/agents/Orchestrator/scripts/post_chat_hook.py\"\" --tags \"\"copilot-chat\"\"\"",
        "cwd": ".",
        "timeout": 10
      }
    ]
  }
}
